rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // App Check is optional; privileged reads require an admin claim or the owner account.
  function admin() { return request.auth != null && (request.auth.token.get('admin', false) == true || request.auth.token.get('email', '') == "rufus090420@gmail.com"); }
  match /products/{id} { allow read: if resource.data.published == true || admin(); allow write: if false; }
  match /categories/{id} { allow read: if resource.data.published == true || admin(); allow write: if false; }
  match /settings/public { allow read: if true; allow write: if false; }
  match /settings/{id} { allow read: if admin(); allow write: if false; }
  match /orders/{id} { allow read: if admin(); allow write: if false; }
  match /audit/{id} { allow read: if admin(); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
