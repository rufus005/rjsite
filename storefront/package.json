{
  "name": "rufus-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/copy-build.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "dev:emulators": "vite --host 127.0.0.1 --mode emulators",
    "build:emulators": "tsc -b && vite build --mode emulators && node scripts/copy-build.mjs",
    "test:appcheck": "playwright test --config playwright.appcheck.config.ts"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
